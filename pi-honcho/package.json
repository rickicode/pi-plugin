{
	"name": "pi-honcho",
	"version": "1.0.0-tweak",
	"description": "Lightweight, self-hosted Honcho memory plugin for Pi and OMP with .env credential loading.",
	"type": "module",
	"main": "dist/index.js",
	"keywords": [
		"pi-package",
		"omp-package",
		"honcho",
		"memory",
		"self-hosted",
		"coding-agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/giuseppecrj/pi-honcho.git"
	},
	"homepage": "https://github.com/giuseppecrj/pi-honcho#readme",
	"bugs": {
		"url": "https://github.com/giuseppecrj/pi-honcho/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"omp": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run lint && npm test",
		"changelog": "auto-changelog --package",
		"version": "npm run changelog && git add CHANGELOG.md"
	},
	"dependencies": {
		"@honcho-ai/sdk": "2.2.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@types/node": "^26.1.1",
		"auto-changelog": "2.6.0",
		"tsx": "^4.23.0",
		"typebox": "^1.3.34",
		"typescript": "^7.0.2"
	}
}
